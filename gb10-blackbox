#!/usr/bin/env python3
"""gb10-blackbox: a flight recorder for NVIDIA GB10 machines (DGX Spark and its siblings).

When a GB10 machine switches itself off, the system journal ends mid-sentence: a hard power-off never gives journald
the time to write its last minutes, and the hardware watchdog does nothing because nothing hung. This records one line
a minute (every thermal zone, the GPU, load and memory), written through to disk, so that after the machine is back
you can see how hot it was and what it was doing when it went dark.

    gb10-blackbox record                 append one reading (the systemd timer runs this every minute)
    gb10-blackbox why                    every gap in the record: the last readings before it and a verdict
    gb10-blackbox bands [--days 30]      how hot the machine runs: share of minutes at 85 to 100 C or more
    gb10-blackbox now                    one reading, printed, nothing written
    gb10-blackbox clock-cap 2000|off     cap the GPU clock (nvidia-smi -lgc 0,MHZ) once the driver answers; off resets it

Standard library only. MIT licence. https://github.com/lightsoutfactory/gb10-blackbox
"""
import argparse
import datetime as dt
import glob
import os
import re
import subprocess
import sys
import time

__version__ = "1.0.0"
LOG = os.environ.get("GB10_BLACKBOX_LOG", "/var/log/gb10-blackbox.log")
UTC = dt.timezone.utc
LINE = re.compile(r"^(?P<ts>\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) hot=(?P<hot>-?\d+) zones=(?P<zones>[-\d,]*) "
                  r"gpu=(?P<gpu>\S+) load=(?P<load>[\d.]+),[\d.]+,[\d.]+ mem=(?P<used>\d+)/(?P<total>\d+)MB\s*$")
GPU = re.compile(r"^(?P<t>\d+)C,(?P<w>[\d.]+)W,(?P<u>\d+)%,(?P<mhz>\d+)MHz$")


# ------------------------------------------------------------------------------------------------ reading --
def zones():
    """Every thermal zone in whole degrees, in zone order (thermal_zone10 after thermal_zone9)."""
    out = []
    paths = glob.glob("/sys/class/thermal/thermal_zone*/temp")
    for p in sorted(paths, key=lambda p: int(re.search(r"thermal_zone(\d+)", p).group(1))):
        try:
            out.append(round(int(open(p).read().strip()) / 1000))
        except (OSError, ValueError):
            pass
    return out


def gpu():
    """GPU temperature, power, utilisation and SM clock from nvidia-smi, or None."""
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=temperature.gpu,power.draw,utilization.gpu,clocks.sm",
                            "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return None
    lines = r.stdout.strip().splitlines()
    if r.returncode or not lines:
        return None
    vals = []
    for part in lines[0].split(","):
        try:
            vals.append(float(part.strip()))
        except ValueError:
            vals.append(None)
    if len(vals) != 4 or vals[0] is None:
        return None
    t, w, u, mhz = vals
    return {"t": int(t), "w": w or 0.0, "u": int(u or 0), "mhz": int(mhz or 0)}


def memory():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, _, v = line.partition(":")
            info[k] = int(v.split()[0])
    total = info["MemTotal"] // 1024
    return total - info.get("MemAvailable", info.get("MemFree", 0)) // 1024, total


def loadavg():
    with open("/proc/loadavg") as f:
        return ",".join(f.read().split()[:3])


def reading(now=None):
    now = now or dt.datetime.now(UTC)
    zs, g = zones(), gpu()
    hot = max(zs + ([g["t"]] if g else []), default=-1)
    used, total = memory()
    load = loadavg()
    gs = f'{g["t"]}C,{g["w"]:.1f}W,{g["u"]}%,{g["mhz"]}MHz' if g else "-"
    return (f"{now:%Y-%m-%dT%H:%M:%SZ} hot={hot} zones={','.join(map(str, zs)) or '-'} gpu={gs} "
            f"load={load} mem={used}/{total}MB")


def record(path, max_mb):
    """Append one line and push it to the disk now: the minute before a power-off is the one that matters."""
    new = not os.path.exists(path)
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, (reading() + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    if new:
        dfd = os.open(os.path.dirname(os.path.abspath(path)), os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    if os.path.getsize(path) > max_mb * 1024 * 1024:
        trim(path)


def trim(path):
    """Keep the newer half of the record (a year of minutes is about 70 MB)."""
    size = os.path.getsize(path)
    with open(path, "rb") as f:
        f.seek(size // 2)
        f.readline()
        rest = f.read()
    tmp = path + ".tmp"
    with open(tmp, "wb") as f:
        f.write(rest)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


# ------------------------------------------------------------------------------------------------ reading back --
class Row:
    __slots__ = ("ts", "hot", "zones", "gpu", "load", "used", "total")

    def __init__(self, m):
        self.ts = dt.datetime.strptime(m["ts"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)
        self.hot = int(m["hot"])
        self.zones = [int(z) for z in m["zones"].split(",") if z.lstrip("-").isdigit()]
        g = GPU.match(m["gpu"])
        self.gpu = {"t": int(g["t"]), "w": float(g["w"]), "u": int(g["u"]), "mhz": int(g["mhz"])} if g else None
        self.load = float(m["load"])
        self.used, self.total = int(m["used"]), int(m["total"])

    def describe(self):
        g = (f'gpu {self.gpu["t"]:3d} C {self.gpu["w"]:5.1f} W {self.gpu["u"]:3d}% {self.gpu["mhz"]:4d} MHz'
             if self.gpu else "gpu n/a")
        return (f"{self.ts:%H:%M} UTC  hottest {self.hot:3d} C  {g}  load {self.load:5.2f}  "
                f"mem {self.used:,}/{self.total:,} MB")


def read_rows(path):
    rows = []
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            m = LINE.match(line)
            if m:
                rows.append(Row(m))
    return rows


def clean_shutdowns():
    """Times of clean shutdowns from wtmp (last -x). A power-off leaves none: its boot stays "still running"."""
    try:
        r = subprocess.run(["last", "-x", "--time-format", "iso", "shutdown"], capture_output=True, text=True,
                           timeout=20, env={**os.environ, "LC_ALL": "C"})
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode:
        return None
    out = []
    for line in r.stdout.splitlines():
        m = re.match(r"^shutdown\s+system down\s+\S+\s+(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d[+-]\d\d:?\d\d)", line)
        if m:
            try:
                out.append(dt.datetime.fromisoformat(m.group(1)).astimezone(UTC))
            except ValueError:
                pass
    return out


def gaps(rows, gap_min):
    """Index pairs (last reading before, first after) wherever the record stops for more than gap_min minutes, or
    the clock went back (a machine that lost power can come back with an old date until it syncs)."""
    out = []
    for i in range(len(rows) - 1):
        d = (rows[i + 1].ts - rows[i].ts).total_seconds()
        if d > gap_min * 60 or d < -60:
            out.append((i, i + 1))
    return out


def verdict(rows, i, hot_c, shutdowns, window_min=10):
    """What the minutes before rows[i] say about the gap after it."""
    last = rows[i]
    before = []
    j = i
    while j >= 0 and 0 <= (last.ts - rows[j].ts).total_seconds() <= window_min * 60:
        before.append(rows[j])
        j -= 1
    before.reverse()
    end = rows[i + 1].ts if i + 1 < len(rows) else last.ts
    if shutdowns is not None:
        for s in shutdowns:
            if last.ts - dt.timedelta(minutes=2) <= s <= max(end, last.ts + dt.timedelta(minutes=2)):
                return "CLEAN", f"a clean shutdown at {s:%H:%M} UTC is in wtmp: a restart someone asked for.", before
    peak = max(r.hot for r in before)
    if peak >= hot_c:
        if last.gpu and last.gpu["u"] < 20:
            side = (f" The GPU was nearly idle ({last.gpu['u']}% at {last.gpu['mhz']} MHz), so the heat came from the "
                    f"CPU cores, not from GPU work.")
        elif last.gpu:
            side = f" The GPU was busy ({last.gpu['u']}% at {last.gpu['mhz']} MHz)."
        else:
            side = ""
        return "HEAT", f"the hottest sensor read {peak} C in the last {window_min} minutes.{side}", before
    free = 100 * (last.total - last.used) / last.total if last.total else 100
    if free < 3:
        return ("MEMORY", f"only {free:.1f}% of memory was free: a hang from memory exhaustion is the likelier cause "
                f"(and a hang is what a hardware watchdog reboots).", before)
    return ("COOL", f"the hottest sensor read {peak} C, below {hot_c} C: look at the power supply and cable, a "
            f"restart, or a hang.", before)


def why(path, gap_min, hot_c, show):
    rows = read_rows(path)
    if not rows:
        print(f"no readings in {path} yet")
        return 1
    shutdowns = clean_shutdowns()
    found = gaps(rows, gap_min)
    tail = (dt.datetime.now(UTC) - rows[-1].ts).total_seconds() / 60
    print(f"{len(rows):,} readings from {rows[0].ts:%Y-%m-%d %H:%M} to {rows[-1].ts:%Y-%m-%d %H:%M} UTC; "
          f"{len(found)} gap(s) of more than {gap_min} minutes")
    if shutdowns is None:
        print("(wtmp could not be read, so a planned restart cannot be told apart from a power-off)")
    counts = {}
    for i, k in found:
        kind, text, before = verdict(rows, i, hot_c, shutdowns)
        counts[kind] = counts.get(kind, 0) + 1
        dark = (rows[k].ts - rows[i].ts).total_seconds() / 60
        dark_s = f"dark for {dark:,.0f} min" if dark >= 0 else "the clock went back, as after a power loss"
        print(f"\n{rows[i].ts:%Y-%m-%d %H:%M} UTC  {dark_s}\n  {kind}: {text}")
        for r in before[-show:]:
            print("   ", r.describe())
    if found:
        print("\n" + ", ".join(f"{k} {v}" for k, v in sorted(counts.items())))
    if tail > gap_min:
        print(f"\nthe newest reading is {tail:,.0f} minutes old: is gb10-blackbox.timer running?")
    return 0


def bands(path, days):
    rows = read_rows(path)
    if not rows:
        print(f"no readings in {path} yet")
        return 1
    since = rows[-1].ts - dt.timedelta(days=days)
    rs = [r for r in rows if r.ts >= since]
    hots = sorted(r.hot for r in rs)
    print(f"{len(rs):,} readings over the last {days} days (to {rows[-1].ts:%Y-%m-%d %H:%M} UTC); hottest sensor:")
    print(f"  median {hots[len(hots) // 2]} C, highest {hots[-1]} C")
    for th in (85, 90, 93, 95, 97, 100):
        n = sum(h >= th for h in hots)
        print(f"  {th:3d} C or more: {100 * n / len(hots):5.1f}% of minutes")
    busy = [r for r in rs if r.gpu and r.gpu["u"] >= 90]
    if busy:
        mhz = sorted(r.gpu["mhz"] for r in busy)
        watts = sorted(r.gpu["w"] for r in busy)
        print(f"  with the GPU busy (90% or more, {len(busy):,} minutes): SM clock median {mhz[len(mhz) // 2]} MHz, "
              f"highest {mhz[-1]} MHz; GPU power median {watts[len(watts) // 2]:.0f} W")
    return 0


# ------------------------------------------------------------------------------------------------ clock cap --
def clock_cap(value, wait_s=60):
    """nvidia-smi cannot set a power limit on GB10 (-pl answers N/A), but it can lock the GPU clock range.
    Wait until the driver answers: run too early at boot, the cap fails, and run too late, the model server has
    already begun its cold start at full power."""
    for _ in range(wait_s):
        try:
            if subprocess.run(["nvidia-smi", "-L"], capture_output=True, timeout=20).returncode == 0:
                break
        except (OSError, subprocess.TimeoutExpired):
            pass
        time.sleep(1)
    cmd = ["nvidia-smi", "-rgc"] if value == "off" else ["nvidia-smi", "-lgc", f"0,{int(value)}"]
    r = subprocess.run(cmd, capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    return r.returncode


def main(argv=None):
    p = argparse.ArgumentParser(prog="gb10-blackbox", description=__doc__.split("\n\n")[0])
    p.add_argument("--log", default=LOG, help=f"the record (default {LOG})")
    p.add_argument("--version", action="version", version=__version__)
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("record", help="append one reading")
    r.add_argument("--max-mb", type=int, default=64, help="keep the record under this size (default 64)")
    w = sub.add_parser("why", help="every gap in the record and what came before it")
    w.add_argument("--gap", type=int, default=5, help="minutes without a reading that count as a gap (default 5)")
    w.add_argument("--hot", type=int, default=93, help="degrees C that count as hot (default 93)")
    w.add_argument("--show", type=int, default=5, help="readings to show before each gap (default 5)")
    b = sub.add_parser("bands", help="how hot the machine runs")
    b.add_argument("--days", type=int, default=30)
    sub.add_parser("now", help="one reading, printed")
    c = sub.add_parser("clock-cap", help="cap the GPU clock, or 'off' to reset it")
    c.add_argument("mhz", help="highest GPU clock in MHz, for example 2000, or off")
    a = p.parse_args(argv)
    if a.cmd == "record":
        record(a.log, a.max_mb)
        return 0
    if a.cmd == "now":
        print(reading())
        return 0
    if a.cmd == "clock-cap":
        if a.mhz != "off" and not a.mhz.isdigit():
            p.error("clock-cap takes a number of MHz or off")
        return clock_cap(a.mhz)
    if not os.path.exists(a.log):
        print(f"no record at {a.log}: install the timer, or pass --log")
        return 1
    if a.cmd == "why":
        return why(a.log, a.gap, a.hot, a.show)
    return bands(a.log, a.days)


if __name__ == "__main__":
    sys.exit(main())
