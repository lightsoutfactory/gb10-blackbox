[Unit]
Description=Cap the GB10 GPU clock before the heavy services start (nvidia-smi -lgc 0,@MHZ@)
Documentation=https://github.com/lightsoutfactory/gb10-blackbox
After=nvidia-persistenced.service
Before=docker.service containerd.service ollama.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gb10-blackbox clock-cap @MHZ@
ExecStop=/usr/local/bin/gb10-blackbox clock-cap off

[Install]
WantedBy=multi-user.target
